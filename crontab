# Daily earnings roll-up at 1:30 AM.
# This crontab runs on the `cron` machine, which starts supercronic only — it
# does not run backend/server.js — so 127.0.0.1:5000 has nothing listening on
# it. The job has to address the web process group over 6PN instead. Plain
# `internetdj.internal` would round-robin across worker machines that don't
# listen on 5000, so target the process group directly.
30 1 * * * curl -sS --fail -X POST http://app.process.internetdj.internal:5000/api/profile/calculate-daily-earnings -H "Content-Type: application/json" -d '{}' >> /app/cron.log 2>&1

# Nightly database backup, offset a couple of hours after the earnings job so
# the dump captures its writes. Writes to the private BACKUP_BUCKET_NAME
# bucket, never the public asset bucket. Requires mariadb-client, which the
# dockerfile installs.
15 3 * * * node backend/scripts/backupDatabase.js >> /app/cron.log 2>&1

*/5 * * * * node backend/scripts/cleanupLoops.js
*/15 * * * * node backend/scripts/cleanupMasteringPreviews.js

# The weekly activity digest, Sunday at 17:00 UTC. Replaces the per-event emails
# utils/notifications.js used to send on every review, follow and reply. It sends
# one message per member listing what they have not read, and nothing at all to a
# member with nothing waiting, so a quiet week is silent.
#
# Scope is unread AND from the last seven days, so a member who never opens the
# bell does not receive the same growing list every week.
0 17 * * 0 node backend/scripts/sendWeeklyDigest.js >> /app/cron.log 2>&1
